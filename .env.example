# GEMINI_API_KEY: gera as imagens das questões (api/imagem.ts, Nano Banana Pro).
# SÓ NO SERVIDOR: configure em Vercel > Settings > Environment Variables.
# Nunca coloque em arquivo com prefixo VITE_ nem suba para o GitHub.
# Opcionais: GEMINI_IMAGE_MODEL (padrão gemini-3-pro-image) e GEMINI_IMAGE_SIZE (padrão 1K).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# IMAGE_PROVIDER: "gemini" (padrão) ou "cloudflare" (FLUX schnell, cota gratuita diária).
# Com "cloudflare", configure no Vercel: CLOUDFLARE_ACCOUNT_ID e CLOUDFLARE_API_TOKEN
# (token com permissão Workers AI). Opcional: CLOUDFLARE_IMAGE_STEPS (1 a 8, padrão 4).
# IMAGE_PROVIDER="cloudflare"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# VITE_SUPABASE_URL="SUA_URL"
# VITE_SUPABASE_ANON_KEY="SUA_KEY"
VITE_ANTHROPIC_API_KEY="SUA_CHAVE_AQUI"

